{
  "schema_version": "dce.authoring-index/v1",
  "project_id": "modernize43",
  "status": "draft",
  "goal": "A single user submits a direct URL to a 4:3 SD film and receives a 1920x1080 H.264 MP4 of its first 30 seconds with a blurred background filling the side bands, a sharp undistorted foreground, an in-page player and a download link.",
  "current_scope": [
    "one direct http(s) media url per job",
    "first 30 seconds only",
    "automatic black-border cropping",
    "lanczos upscaling with contrast-adaptive sharpening",
    "optional joyn logo overlay from a dropdown",
    "blurred pillarbox composition without distortion",
    "job states and error messages",
    "html5 player and mp4 download",
    "private-address rejection by default",
    "optional 16:9 joyn intro prepended in full",
    "configurable content duration, default 30 seconds",
    "arabella 768x576 source preset"
  ],
  "out_of_scope": [
    "batch processing",
    "transcoding beyond 30 seconds",
    "page scraping and platform integrations",
    "subtitle and chapter preservation",
    "ai upscaling and regrading",
    "accounts and authentication",
    "persistence across restarts",
    "container images and remote deployment",
    "mobile-specific layout"
  ],
